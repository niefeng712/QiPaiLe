static func get_game(id: String) -> Dictionary:
	for g in GAMES:
		if str(g["id"]) == id:
			return g
	return {}


static func default_rules(id: String) -> Dictionary:
	var out = {}
	var g = get_game(id)
	for r in g.get("rules", []):
		out[str(r["key"])] = str(r["default"])
	var fixed = g.get("fixed", {})
	for k in fixed:
		out[str(k)] = str(fixed[k])
	return out
